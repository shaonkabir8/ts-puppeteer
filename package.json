{
  "name": "ts-puppeteer",
  "version": "1.0.0",
  "description": "A minimal project generator for Puppeteer and TypeScript with a Jest setup: yarn create ts-puppeteer my-project",
  "author": "Shaon Kabir <shaonkabir8>",
  "homepage": "https://github.com/shaonkabir8/ts-puppeteer#readme",
  "license": "MIT",
  "keywords": [
    "typescript",
    "puppeteer",
    "jest",
    "boilerplate",
    "generator",
    "create",
    "scaffold",
    "ts-puppeteer"
  ],
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "create-ts-puppeteer": "bin/create-ts-puppeteer.js"
  },
  "files": [
    "bin",
    "templates"
  ],
  "scripts": {
    "start": "ts-node src/index.ts",
    "build": "tsc",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "jest",
    "test:watch": "jest --watch",
    "scaffold": "node bin/create-ts-puppeteer.js"
  },
  "dependencies": {
    "debug": "^4.4.3",
    "dotenv": "^18.0.0",
    "puppeteer": "^25.17.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@babel/plugin-transform-modules-commonjs": "^7.29.14",
    "@eslint/js": "^9.39.0",
    "@types/debug": "^4.1.13",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "babel-jest": "^30.5.2",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.5.0",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.46.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shaonkabir8/ts-puppeteer.git"
  },
  "bugs": {
    "url": "https://github.com/shaonkabir8/ts-puppeteer/issues"
  }
}
