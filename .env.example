# Copy this file to `.env` and adjust the values.
# Every value below is optional; sensible defaults are used when unset.

# URL visited by the demo script (src/index.ts)
TARGET_URL=https://example.com

# Extra Chrome arguments, space separated.
# Leave empty on your own machine. In CI containers running as root you may need:
# PUPPETEER_CHROME_ARGS="--no-sandbox --disable-setuid-sandbox"
PUPPETEER_CHROME_ARGS=

# Optional: reuse a persistent browser profile directory
# (defaults to a temporary profile that Puppeteer cleans up automatically)
# PUPPETEER_PROFILE_DIR=/absolute/path/to/profile
